variable "override_name" {
  description = "Optional override for naming logic."
  type        = string
  default     = null
  nullable    = true

  validation {
    condition     = var.override_name == null || try(length(trimspace(var.override_name)) > 0, false)
    error_message = format("Invalid value '%s' for variable 'override_name', it must be null or a non-empty string.", coalesce(var.override_name, "null"))
  }
}

variable "workload" {
  description = "Short, descriptive name for the application, service, or workload. Used in resource naming conventions."
  type        = string
  nullable    = true

  validation {
    condition     = var.workload == null || try(length(trimspace(var.workload)) > 0, false)
    error_message = format("Invalid value '%s' for variable 'workload', it must be null or a non-empty string.", coalesce(var.workload, "null"))
  }
}

variable "company_prefix" {
  description = "Short, unique prefix for the company / organization."
  type        = string
  nullable    = true

  validation {
    condition     = var.company_prefix == null || try(length(trimspace(var.company_prefix)) > 0 && length(var.company_prefix) <= 5, false)
    error_message = format("Invalid value '%s' for variable 'company_prefix', it must be a non-empty string with a maximum of 5 characters.", coalesce(var.company_prefix, "null"))
  }
}

variable "sequence_number" {
  description = "Optional numeric instance counter, zero-padded as `-NNN` suffix. Use only when provisioning multiple PostgreSQL Flexible Servers for the same workload/env/region. Omit for the common single-instance case."
  type        = number
  default     = null
  nullable    = true

  validation {
    condition     = var.sequence_number == null || try(var.sequence_number >= 1 && var.sequence_number <= 999, false)
    error_message = format("Invalid value '%s' for variable 'sequence_number', it must be null or a number between 1 and 999.", coalesce(var.sequence_number, "null"))
  }
}

variable "location" {
  description = "Specifies Azure location where the resources should be provisioned. For an exhaustive list of locations, please use the command 'az account list-locations -o table'."
  type        = string
  nullable    = false

  validation {
    condition     = length(trimspace(var.location)) > 0
    error_message = format("Invalid value '%s' for variable 'location', it must be a non-empty string.", var.location)
  }
}

variable "environment" {
  description = "The environment in which the resource should be provisioned."
  type        = string
  nullable    = false
}

variable "resource_group_name" {
  description = "Specifies the name of the resource group where the resource should be provisioned."
  type        = string
  nullable    = false

  validation {
    condition     = length(trimspace(var.resource_group_name)) > 0
    error_message = format("Invalid value '%s' for variable 'resource_group_name', it must be a non-empty string.", var.resource_group_name)
  }
}

variable "admin_settings" {
  description = "Administrative access for the PostgreSQL Flexible Server: the local administrator login (`local_username`). The password is generated by the module at creation and is never stored or surfaced; it is expected to be reset out-of-band and Terraform ignores later changes to it. Changing the username after creation forces a new server."
  type = object({
    local_username = string
  })

  validation {
    condition     = can(regex("^[A-Za-z0-9]{1,63}$", var.admin_settings.local_username))
    error_message = "Invalid value for 'admin_settings.local_username'. It must be 1 to 63 characters long and contain only letters and numbers."
  }

  validation {
    condition     = !contains(["admin", "administrator", "root", "guest", "public", "sa", "azuresu"], lower(trimspace(var.admin_settings.local_username)))
    error_message = "Invalid value for 'admin_settings.local_username'. Azure rejects reserved login names: admin, administrator, root, guest, public, sa, azuresu."
  }
}

variable "postgresql_version" {
  description = "The major version of PostgreSQL. Only applied at creation: later changes are ignored by Terraform, as a major version change would force a new server and upgrades are an operational task."
  type        = string
  nullable    = false

  validation {
    condition     = contains(["13", "14", "15", "16"], var.postgresql_version)
    error_message = format("Invalid value '%s' for variable 'postgresql_version', valid options are '13', '14', '15', '16'.", var.postgresql_version)
  }
}

variable "sku_name" {
  description = "The initial SKU of the server, following the `{tier}_Standard_{name}` pattern (e.g. `B_Standard_B1ms`, `GP_Standard_D2ds_v5`, `MO_Standard_E4ds_v5`). Only applied at creation: later changes are ignored by Terraform, as scaling is an operational task."
  type        = string
  nullable    = false

  validation {
    condition     = can(regex("^((B_Standard_B((1|2|4|8|12|16|20)ms|2s))|(GP_Standard_D(((2|4|8|16|32|48|64)s_v3)|((2|4|8|16|32|48|64)ds_v4)|((2|4|8|16|32|48|64|96)ds_v5)|((2|4|8|16|32|48|64|96)ads_v5)))|(MO_Standard_E((((2|4|8|16|20|32|48|64)s)_v3)|((2|4|6|8|16|20|32|48|64)ds_v4)|((2|4|8|16|20|32|48|64|96)ds_v5)|((2|4|8|16|32|48|64|96)ads_v5))))$", var.sku_name))
    error_message = format("Invalid value '%s' for variable 'sku_name', it must follow the '{tier}_Standard_{name}' pattern with a tier of 'B', 'GP' or 'MO' (e.g. 'B_Standard_B1ms', 'GP_Standard_D2ds_v5', 'MO_Standard_E4ds_v5').", var.sku_name)
  }
}

variable "storage_mb" {
  description = "The initial storage of the server in megabytes. Only applied at creation: later changes are ignored by Terraform, as scaling is an operational task."
  type        = number
  default     = 32768
  nullable    = false

  validation {
    condition     = contains([32768, 65536, 131072, 262144, 524288, 1048576, 2097152, 4193280, 4194304, 8388608, 16777216, 33553408], var.storage_mb)
    error_message = format("Invalid value '%s' for variable 'storage_mb', valid options are 32768, 65536, 131072, 262144, 524288, 1048576, 2097152, 4193280, 4194304, 8388608, 16777216, 33553408.", var.storage_mb)
  }
}

variable "storage_tier" {
  description = "The initial storage performance tier (IOPS) of the server. When null, Azure picks the default for the chosen `storage_mb`. Only applied at creation: later changes are ignored by Terraform, as scaling is an operational task."
  type        = string
  default     = null
  nullable    = true

  validation {
    condition     = var.storage_tier == null || contains(["P4", "P6", "P10", "P15", "P20", "P30", "P40", "P50", "P60", "P70", "P80"], coalesce(var.storage_tier, "null"))
    error_message = format("Invalid value '%s' for variable 'storage_tier', it must be null or one of 'P4', 'P6', 'P10', 'P15', 'P20', 'P30', 'P40', 'P50', 'P60', 'P70', 'P80'.", coalesce(var.storage_tier, "null"))
  }
}

variable "auto_grow_enabled" {
  description = "Whether the storage of the server grows automatically when it approaches its limit. Enabled by default, so the server does not go read-only when the disk fills up. Storage can only grow, never shrink."
  type        = bool
  default     = true
  nullable    = false
}

variable "zone" {
  description = "The availability zone ('1', '2' or '3') of the primary server. When null, Azure assigns one. Changes are ignored by Terraform, as a fail-over moves the primary to the standby zone."
  type        = string
  default     = null
  nullable    = true

  validation {
    condition     = var.zone == null || contains(["1", "2", "3"], coalesce(var.zone, "null"))
    error_message = format("Invalid value '%s' for variable 'zone', it must be null or one of '1', '2', '3'.", coalesce(var.zone, "null"))
  }
}

variable "high_availability" {
  description = "High availability configuration: `mode` is 'SameZone' or 'ZoneRedundant', `standby_availability_zone` optionally pins the standby zone. Null disables high availability. Not supported on Burstable ('B_') SKUs."
  type = object({
    mode                      = string
    standby_availability_zone = optional(string)
  })
  default  = null
  nullable = true

  validation {
    condition     = var.high_availability == null || try(contains(["SameZone", "ZoneRedundant"], var.high_availability.mode), false)
    error_message = "Invalid value for 'high_availability.mode', it must be 'SameZone' or 'ZoneRedundant'."
  }

  validation {
    condition     = try(var.high_availability.standby_availability_zone, null) == null || contains(["1", "2", "3"], coalesce(try(var.high_availability.standby_availability_zone, null), "null"))
    error_message = "Invalid value for 'high_availability.standby_availability_zone', it must be null or one of '1', '2', '3'."
  }
}

variable "backup_retention_days" {
  description = "The number of days backups are retained, between 7 and 35."
  type        = number
  default     = 7
  nullable    = false

  validation {
    condition     = try(var.backup_retention_days >= 7 && var.backup_retention_days <= 35, false)
    error_message = format("Invalid value '%s' for variable 'backup_retention_days', it must be a number between 7 and 35.", var.backup_retention_days)
  }
}

variable "geo_redundant_backup_enabled" {
  description = "Whether geo-redundant backup is enabled. Only available in Azure paired regions. Changing this after creation forces a new server."
  type        = bool
  default     = false
  nullable    = false
}

variable "public_network_access_enabled" {
  description = "Whether or not public network access is allowed for this server. Firewall rules are not managed by this module, so with public access enabled the server stays unreachable from the internet until rules are added elsewhere."
  type        = bool
  default     = false
  nullable    = false
}

variable "private_endpoint_settings" {
  description = "Settings for the private endpoint provisioned by this module. `subnet_id` is the resource ID of the subnet where the PEP NIC lands. `private_dns_zone_ids` maps each required subresource to its private DNS zone resource ID."
  type = object({
    subnet_id = string
    private_dns_zone_ids = object({
      postgresqlServer = string
    })
  })
}
