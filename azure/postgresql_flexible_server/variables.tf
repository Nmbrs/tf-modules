variable "override_name" {
  description = "Optional override for naming logic."
  type        = string
  default     = null
  nullable    = true

  validation {
    condition     = var.override_name == null || try(length(trimspace(var.override_name)) > 0, false)
    error_message = format("Invalid value '%s' for variable 'override_name', it must be null or a non-empty string.", coalesce(var.override_name, "null"))
  }
}

variable "workload" {
  description = "Short, descriptive name for the application, service, or workload. Used in resource naming conventions."
  type        = string
  nullable    = true

  validation {
    condition     = var.workload == null || try(length(trimspace(var.workload)) > 0, false)
    error_message = format("Invalid value '%s' for variable 'workload', it must be null or a non-empty string.", coalesce(var.workload, "null"))
  }
}

variable "company_prefix" {
  description = "Short, unique prefix for the company / organization."
  type        = string
  nullable    = true

  validation {
    condition     = var.company_prefix == null || try(length(trimspace(var.company_prefix)) > 0 && length(var.company_prefix) <= 5, false)
    error_message = format("Invalid value '%s' for variable 'company_prefix', it must be a non-empty string with a maximum of 5 characters.", coalesce(var.company_prefix, "null"))
  }
}

variable "sequence_number" {
  description = "Optional numeric instance counter, zero-padded as `-NNN` suffix. Use only when provisioning multiple PostgreSQL Flexible Servers for the same workload/env/region. Omit for the common single-instance case."
  type        = number
  default     = null
  nullable    = true

  validation {
    condition     = var.sequence_number == null || try(var.sequence_number >= 1 && var.sequence_number <= 999, false)
    error_message = format("Invalid value '%s' for variable 'sequence_number', it must be null or a number between 1 and 999.", coalesce(var.sequence_number, "null"))
  }
}

variable "location" {
  description = "Specifies Azure location where the resources should be provisioned. For an exhaustive list of locations, please use the command 'az account list-locations -o table'."
  type        = string
  nullable    = false

  validation {
    condition     = length(trimspace(var.location)) > 0
    error_message = format("Invalid value '%s' for variable 'location', it must be a non-empty string.", var.location)
  }
}

variable "environment" {
  description = "The environment in which the resource should be provisioned."
  type        = string
  nullable    = false

  validation {
    condition     = length(trimspace(var.environment)) > 0
    error_message = format("Invalid value '%s' for variable 'environment', it must be a non-empty string.", var.environment)
  }
}

variable "resource_group_name" {
  description = "Specifies the name of the resource group where the resource should be provisioned."
  type        = string
  nullable    = false

  validation {
    condition     = length(trimspace(var.resource_group_name)) > 0
    error_message = format("Invalid value '%s' for variable 'resource_group_name', it must be a non-empty string.", var.resource_group_name)
  }
}

variable "admin_settings" {
  description = "Administrative access for the PostgreSQL Flexible Server. `azuread_group_name` is the Microsoft Entra security group set as server administrator. With `azuread_authentication_only_enabled = true` (the default) Entra ID is the only authentication method and no local administrator or password exists. With `false` the server is created in hybrid mode: Entra ID plus the local administrator `local_username` (required in this mode), whose password is generated by the module at creation, is never stored or surfaced, is expected to be reset out-of-band and is ignored by Terraform afterwards. Choose the mode when the server is created: a hybrid server can later be locked down by setting the flag to `true`, but switching back to password authentication is not supported through Terraform."
  type = object({
    azuread_group_name                  = string
    azuread_authentication_only_enabled = optional(bool, true)
    local_username                      = optional(string)
  })
  nullable = false

  validation {
    condition     = length(trimspace(var.admin_settings.azuread_group_name)) > 0
    error_message = "Invalid value for 'admin_settings.azuread_group_name'. It must be a non-empty string."
  }

  validation {
    condition     = var.admin_settings.azuread_authentication_only_enabled || try(length(trimspace(var.admin_settings.local_username)) > 0, false)
    error_message = "Invalid value for 'admin_settings.local_username'. It is required when 'azuread_authentication_only_enabled' is false."
  }

  validation {
    condition     = var.admin_settings.local_username == null || can(regex("^[A-Za-z0-9]{1,63}$", try(var.admin_settings.local_username, "")))
    error_message = "Invalid value for 'admin_settings.local_username'. It must be 1 to 63 characters long and contain only letters and numbers."
  }

  validation {
    condition = try(
      !contains(["azure_superuser", "azure_pg_admin", "admin", "administrator", "root", "guest", "public"], lower(trimspace(var.admin_settings.local_username)))
      && !startswith(lower(trimspace(var.admin_settings.local_username)), "pg_"),
      true
    )
    error_message = "Invalid value for 'admin_settings.local_username'. Azure rejects reserved PostgreSQL login names: azure_superuser, azure_pg_admin, admin, administrator, root, guest, public, and any name starting with 'pg_'."
  }
}

variable "postgresql_version" {
  description = "The major version of PostgreSQL. Only applied at creation: later changes are ignored by Terraform, as a major version change would force a new server and upgrades are an operational task."
  type        = string
  default     = "16"
  nullable    = false

  validation {
    condition     = contains(["13", "14", "15", "16"], var.postgresql_version)
    error_message = format("Invalid value '%s' for variable 'postgresql_version', valid options are '13', '14', '15', '16'.", var.postgresql_version)
  }
}

variable "sku_name" {
  description = "The initial SKU of the server, following the `{tier}_Standard_{name}` pattern (e.g. `B_Standard_B1ms`, `GP_Standard_D2ds_v5`, `MO_Standard_E4ds_v5`). Only applied at creation: later changes are ignored by Terraform, as scaling is an operational task."
  type        = string
  nullable    = false

  validation {
    condition     = can(regex("^((B_Standard_B((1|2|4|8|12|16|20)ms|2s))|(GP_Standard_D(((2|4|8|16|32|48|64)s_v3)|((2|4|8|16|32|48|64)ds_v4)|((2|4|8|16|32|48|64|96)ds_v5)|((2|4|8|16|32|48|64|96)ads_v5)))|(MO_Standard_E((((2|4|8|16|20|32|48|64)s)_v3)|((2|4|6|8|16|20|32|48|64)ds_v4)|((2|4|8|16|20|32|48|64|96)ds_v5)|((2|4|8|16|32|48|64|96)ads_v5))))$", var.sku_name))
    error_message = format("Invalid value '%s' for variable 'sku_name', it must follow the '{tier}_Standard_{name}' pattern with a tier of 'B', 'GP' or 'MO' (e.g. 'B_Standard_B1ms', 'GP_Standard_D2ds_v5', 'MO_Standard_E4ds_v5').", var.sku_name)
  }
}

variable "storage_mb" {
  description = "The initial storage of the server in megabytes. Only applied at creation: later changes are ignored by Terraform, as scaling is an operational task."
  type        = number
  default     = 32768
  nullable    = false

  validation {
    condition     = contains([32768, 65536, 131072, 262144, 524288, 1048576, 2097152, 4193280, 4194304, 8388608, 16777216, 33553408], var.storage_mb)
    error_message = format("Invalid value '%s' for variable 'storage_mb', valid options are 32768, 65536, 131072, 262144, 524288, 1048576, 2097152, 4193280, 4194304, 8388608, 16777216, 33553408.", var.storage_mb)
  }
}

variable "auto_grow_enabled" {
  description = "Whether the storage of the server grows automatically when it approaches its limit. Enabled by default, so the server does not go read-only when the disk fills up. Only applied at creation: later changes are ignored by Terraform, so it can be changed as part of an operational runbook. Storage can only grow, never shrink."
  type        = bool
  default     = true
  nullable    = false
}

variable "zone" {
  description = "The availability zone ('1', '2' or '3') of the primary server. When null, Azure assigns one. Only applied at creation: a fail-over swaps the primary and standby zones, so later changes are ignored by Terraform."
  type        = string
  default     = null
  nullable    = true

  validation {
    condition     = var.zone == null || contains(["1", "2", "3"], coalesce(var.zone, "null"))
    error_message = format("Invalid value '%s' for variable 'zone', it must be null or one of '1', '2', '3'.", coalesce(var.zone, "null"))
  }
}

variable "high_availability_mode" {
  description = "High availability mode of the server: null (disabled), 'SameZone' or 'ZoneRedundant'. Not supported by Burstable ('B_') SKUs. The standby zone is chosen by Azure and ignored by Terraform afterwards."
  type        = string
  default     = null
  nullable    = true

  validation {
    condition     = var.high_availability_mode == null || contains(["SameZone", "ZoneRedundant"], coalesce(var.high_availability_mode, "null"))
    error_message = format("Invalid value '%s' for variable 'high_availability_mode', it must be null, 'SameZone' or 'ZoneRedundant'.", coalesce(var.high_availability_mode, "null"))
  }
}

variable "backup_settings" {
  description = "Backup configuration: `retention_days` (7 to 35) and `geo_redundant_enabled`. Geo-redundancy is only available in Azure paired regions and can only be chosen at creation; changing it afterwards replaces the server."
  type = object({
    retention_days        = optional(number, 7)
    geo_redundant_enabled = optional(bool, false)
  })
  default  = {}
  nullable = false

  validation {
    condition     = var.backup_settings.retention_days >= 7 && var.backup_settings.retention_days <= 35
    error_message = format("Invalid value '%s' for 'backup_settings.retention_days', it must be a number between 7 and 35.", var.backup_settings.retention_days)
  }
}

variable "public_network_access_enabled" {
  description = "Whether or not public network access is allowed for this server. Firewall rules are not managed by this module, so with public access enabled the server stays unreachable from the internet until rules are added elsewhere."
  type        = bool
  default     = false
  nullable    = false
}

variable "private_endpoint_settings" {
  description = "Settings for the private endpoint provisioned by this module. `subnet_id` is the resource ID of the subnet where the PEP NIC lands. `private_dns_zone_ids` maps each required subresource to its private DNS zone resource ID."
  type = object({
    subnet_id = string
    private_dns_zone_ids = object({
      postgresqlServer = string
    })
  })
  nullable = false

  validation {
    condition     = length(trimspace(var.private_endpoint_settings.subnet_id)) > 0
    error_message = "Invalid value for 'private_endpoint_settings.subnet_id'. It must be a non-empty string."
  }

  validation {
    condition     = length(trimspace(var.private_endpoint_settings.private_dns_zone_ids.postgresqlServer)) > 0
    error_message = "Invalid value for 'private_endpoint_settings.private_dns_zone_ids.postgresqlServer'. It must be a non-empty string."
  }
}
